# ── Android 内置桥（extension 模式）────────────────────────────────────────────
# 安卓包内置了设备内的音源协议实现（src/audioNative/）+ 原生 OkHttp/Cookie 插件，
# 因此手机端无需任何外部后端。把对应 provider 的 base 显式设为 `extension` 即可强制走桥：
#
#   VITE_NETEASE_API_BASE=extension
#   VITE_KUGOU_API_BASE=extension
#   VITE_QQ_API_BASE=extension
#
# 未设置时的实际行为：
#   - 网易云：在非 Electron 且 base 未配置时自动尝试走桥（桥不可用才报 NETEASE_API_UNAVAILABLE）。
#   - 酷狗 / QQ：仅当 base 为 `extension`（即 isFoliaExtensionBridgeConfigured）时走桥；
#     否则沿用下面的外部 base URL 逻辑。
#
# ⚠️ 汽水音乐（Qishui）**不在桥的覆盖范围内**：参考实现与设备内协议均无汽水实现，
#    它仍然只能通过下面的 VITE_QISHUI_API_BASE 指向外部 qishui-api 实例；
#    该值为空时汽水入口隐藏（不报错）。

# Netease Cloud Music API Base URL
# If running the API locally, it might be http://localhost:3000
# If using a deployed instance, use the full URL
VITE_NETEASE_API_BASE=http://localhost:3000

# Qishui (汽水音乐) API Base URL
# Points to a reachable qishui-api instance, e.g. http://localhost:3300, to enable
# Qishui sign-in, search and playlists.
VITE_QISHUI_API_BASE=

# qq-music-api Base URL (optional for Web and development builds)
# Electron packages and starts the embedded QQ Music API automatically.
# For Web or development builds, point this variable to a reachable QQ Music API instance,
# e.g. http://localhost:3200, to enable QQ Music sign-in and playlists.
VITE_QQ_API_BASE=

# KuGou Music API Base URL (optional)
# For Web or development builds, point this to a reachable KuGouMusicApi instance
# (e.g. http://localhost:3300) to enable KuGou sign-in, search and playlists.
# Set to `extension` on Android to route KuGou through the built-in native bridge.
VITE_KUGOU_API_BASE=

# lyric-proxy Base URL (optional)
# QQ/Kugou lyrics, search and cover images are fetched through a CORS proxy at `/api/lyric-proxy`.
# On Web/Docker builds this is served by the same backend, so leave blank. For standalone Capacitor
# (Android) builds there is no same-origin backend, so point this to a separately deployed proxy,
# e.g. http://your-host:3400, to make QQ/Kugou search, lyrics and covers work in the app.
VITE_LYRIC_PROXY_BASE=

# AI Provider
# Set to 'google' for Google Gemini (recommended for better JSON response), 
# or 'openai' for OpenAI and other openai compatible APIs, like DeepSeek, Qwen, etc.
VITE_AI_PROVIDER=google

# Google Gemini API Key for AI features
# only needed if you want to use Google Gemini.
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI Compatible API
# if you want to use OpenAI or other openai compatible APIs, like DeepSeek, Qwen, etc. set VITE_AI_PROVIDER=openai and set the following variables.
# OPENAI_API_URL accepts either a base URL (for example https://api.deepseek.com or https://api.openai.com/v1)
# or a full chat completions endpoint.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_URL=https://api.openai.com/v1
# OPENAI_API_MODEL is strongly recommended for compatible providers that require an explicit model name.
# For api.deepseek.com, the app defaults to deepseek-v4-flash if you leave this blank, but setting it explicitly is clearer.
OPENAI_API_MODEL=gpt-4o
# Optional. Accepts 0-2 and defaults to 0.7 when omitted or invalid.
OPENAI_API_TEMPERATURE=0.7
